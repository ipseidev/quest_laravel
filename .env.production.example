# ---------------------------------------------------------------------------
# Quest backend — PRODUCTION environment template.
# Copy to `.env` on the production host and fill every [REPLACE] value.
# Never commit the real .env. Back up APP_KEY separately from DB dumps —
# losing it makes every user's encrypted content unrecoverable.
# ---------------------------------------------------------------------------

APP_NAME=Nacre
APP_ENV=production
APP_KEY=                       # generate once: `php artisan key:generate --show` — then store it OUTSIDE the DB backups
APP_DEBUG=false                # MUST be false in prod (true leaks stack traces on 500s)
APP_URL=https://thequesting.app             # public HTTPS base; the mobile QUESTING_API_URL points at <APP_URL>/api

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Logging — quieter in prod
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning              # info or warning, never debug

# Database — managed Postgres with daily backups
DB_CONNECTION=pgsql
DB_HOST=REPLACE
DB_PORT=5432
DB_DATABASE=REPLACE
DB_USERNAME=REPLACE
DB_PASSWORD=REPLACE

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database       # AI Chapters run as QUEUED jobs → a queue:work daemon is REQUIRED (see checklist)
CACHE_STORE=database

# ---------------------------------------------------------------------------
# Binary storage (attachments, audio, character photos) — object storage.
# FILESYSTEM_DISK MUST be s3 in prod so uploads don't land on ephemeral local disk.
# Set AWS_URL to your bucket/CDN HTTPS base so Storage::disk('s3')->url() returns
# https:// URLs (the app rejects non-HTTPS in production).
# ---------------------------------------------------------------------------
FILESYSTEM_DISK=s3
# Cloudflare R2 (S3-compatible). region=auto, path-style=true are R2 requirements.
AWS_ACCESS_KEY_ID=REPLACE-r2-access-key-id
AWS_SECRET_ACCESS_KEY=REPLACE-r2-secret-access-key
AWS_DEFAULT_REGION=auto
AWS_BUCKET=quest-app
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=https://REPLACE-account-id.r2.cloudflarestorage.com
# PUBLIC download base — the bucket's pub-<hash>.r2.dev domain OR a custom domain.
# NOT the .r2.cloudflarestorage.com S3 API endpoint (that one is private → 400 on
# unauthenticated GET, so clients can't download from it).
AWS_URL=https://pub-be2448a5097447c480bc95e2805ee32d.r2.dev   # r2.dev public URL; swap for a custom domain in real prod

# ---------------------------------------------------------------------------
# OAuth — these MUST match the mobile client, or /api/auth/apple and
# /api/auth/google return 401:
#   APPLE_CLIENT_ID  = the iOS bundle id  -> com.affiniteam.quest  (production build)
#   GOOGLE_CLIENT_ID = the SAME value as the app's QUESTING_GOOGLE_WEB_CLIENT_ID
# ---------------------------------------------------------------------------
APPLE_CLIENT_ID=com.affiniteam.quest
GOOGLE_CLIENT_ID=117756047479-6dnemvgb4kms05h8j857563pr90phgpu.apps.googleusercontent.com
# iOS OAuth client id — also accepted as a valid Google idToken audience.
GOOGLE_IOS_CLIENT_ID=117756047479-1r1jid9r6q28ua1re4na53dfr4c6pvfp.apps.googleusercontent.com

# Sync throttle (requests / minute / user); default is 60
QUEST_RATE_LIMIT_SYNC=60

# Free-tier cloud media backup quota (MB). Text/metadata backup is unmetered;
# only binaries (photos/audio) count. Nacre Plus subscribers are unlimited.
QUEST_FREE_MEDIA_QUOTA_MB=500

# ---------------------------------------------------------------------------
# Billing — RevenueCat webhook (REQUIRED before selling Nacre Plus)
#
# This webhook is the ONLY thing that writes users.subscription_product_id, and
# that column is what gates the paid features server-side: unlimited media
# backup and the recurring AI Chapters. Leave the secret unset and every event
# is rejected, so a paying subscriber stays on the free tier while the app shows
# them as premium — and the Chapters the terms promise never arrive.
#
# Setup, in the RevenueCat dashboard (Project settings → Integrations → Webhooks):
#   1. URL:  https://thequesting.app/api/webhooks/revenuecat
#   2. Paste the SAME value as below into "Authorization header value".
#   3. Check that the entitlement identifier is `plus` (it must match the app's
#      PLUS_ENTITLEMENT and REVENUECAT_ENTITLEMENT below).
#   4. Set the transfer behaviour to "Transfer to new App User ID" — otherwise a
#      purchase made before signing in never reaches the account.
#   5. Send a test event; expect 200 with {"status":"test"}.
# ---------------------------------------------------------------------------
REVENUECAT_WEBHOOK_SECRET=REPLACE-with-a-long-random-string
REVENUECAT_ENTITLEMENT=plus

# Webhook throttle (requests / minute / IP); generous so a burst of RevenueCat
# retries is never throttled into a lost billing event.
QUEST_RATE_LIMIT_WEBHOOK=300

# ---------------------------------------------------------------------------
# AI Chapters ("Le Chapitre") — server-side generation via Anthropic. Premium
# feature: recurring generation selects on User::scopeWithActiveSubscription(),
# which is fed by the RevenueCat webhook above. Requires the queue worker below.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=REPLACE-anthropic-api-key
ANTHROPIC_CHAPTER_MODEL=claude-opus-5     # must support json_schema structured output; Opus over Sonnet because a Chapter is the paid product (~$0.20 vs ~$0.10 per chapter)
ANTHROPIC_CHAPTER_MAX_TOKENS=32000        # shared by adaptive thinking + JSON output; an unspent cap costs nothing
QUEST_CHAPTERS_ENABLED=true               # master switch for chapter generation
QUEST_CHAT_ENABLED=false                  # Talk-to-Myself stays parked

# Mail — only needed once password reset / email verification (deferred) land
MAIL_MAILER=log

# ---------------------------------------------------------------------------
# Host requirements (NOT env vars — checklist):
#   • Run the Laravel scheduler every minute, e.g. crontab:
#       * * * * * cd /path/to/app && php artisan schedule:run >> /dev/null 2>&1
#     Without it, quest:purge-expired never runs → 30-day retention breaks and
#     soft-deleted rows + their S3 binaries accumulate forever.
#   • Run a QUEUE WORKER daemon (Chapters are queued jobs), e.g. Supervisor/Forge:
#       php artisan queue:work --tries=4 --timeout=120
#     Without it, monthly/annual Chapters are enqueued on schedule but never
#     generated — the AI feature silently produces nothing.
#   • Terminate HTTPS upstream (load balancer / reverse proxy); the app assumes it.
#   • Run `php artisan migrate --force` on deploy.
# ---------------------------------------------------------------------------
