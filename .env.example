APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=quest_laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Chapter generation runs on the queue, so a deployment without a `queue:work` daemon
# dispatches jobs that are never executed — `artisan` prints "Dispatched N job(s)" and
# nothing is produced. Account deletion (DeleteUserBinaries) is queued too, so a missing
# worker also leaves erased users' photos in the bucket.
# DB_QUEUE_RETRY_AFTER must stay GREATER than the worker's --timeout, or a slow Claude
# call is handed to a second worker while the first is still running: two billed calls
# and a duplicated chapter. Suggested pair: retry_after 600 / --timeout 300.
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=600

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Object storage (photos + voice notes) ────────────────────────────
# Production is Cloudflare R2, not AWS. `AWS_ENDPOINT` and `AWS_URL` are therefore
# NOT optional, and the `s3` disk is configured with 'throw' => false, so getting
# either wrong fails silently — uploads report success and store nothing.
#   AWS_DEFAULT_REGION = `auto` on R2.
#   AWS_ENDPOINT       = https://<account_id>.r2.cloudflarestorage.com  (mind the .com)
#   AWS_URL            = the bucket's PUBLIC domain (pub-<hash>.r2.dev or a custom
#                        domain). Storage::url() builds `remote_uri` from it; without
#                        it the app stores links to the private, signed-only endpoint
#                        and every image 403s at download time.
# R2 has no object-level ACLs — public reads come from the bucket, so the code never
# passes a `public` visibility. Verify a real round trip, not just the config:
#   php artisan tinker --execute 'var_dump(Storage::disk("s3")->put("healthcheck.txt","ok"));'
#   curl -I "$(php artisan tinker --execute 'echo Storage::disk("s3")->url("healthcheck.txt");')"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# ── OAuth: Sign in with Apple / Google ───────────────────────────────
# Required for /api/auth/apple and /api/auth/google — without them those
# endpoints return 401 (the verifiers refuse to run with an empty client id).
#   APPLE_CLIENT_ID      = the iOS bundle id of the build hitting this server.
#                          Local dev uses the `development` variant → the `.dev`
#                          suffix (com.affiniteam.quest.dev). Prod = com.affiniteam.quest.
#   GOOGLE_CLIENT_ID     = the WEB client id, same value as the app's
#                          QUESTING_GOOGLE_WEB_CLIENT_ID in quest_expo/eas.json.
#   GOOGLE_IOS_CLIENT_ID = the iOS OAuth client id (also accepted as an audience).
APPLE_CLIENT_ID=com.affiniteam.quest.dev
GOOGLE_CLIENT_ID=117756047479-6dnemvgb4kms05h8j857563pr90phgpu.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=117756047479-1r1jid9r6q28ua1re4na53dfr4c6pvfp.apps.googleusercontent.com

# ── Billing: RevenueCat webhook ──────────────────────────────────────
# POST /api/webhooks/revenuecat is the ONLY writer of users.subscription_product_id.
# An unset secret rejects every event with 401 rather than trusting anything, so a
# paying subscriber stays capped at the free media quota and receives no recurring
# Chapter while the app — which reads RevenueCat directly — shows them as premium.
# One error line is logged per rejected delivery: quest.billing.webhook_unconfigured.
#   REVENUECAT_WEBHOOK_SECRET = same value as the dashboard's "Authorization header
#                               value" field (accepted with or without `Bearer `).
#   REVENUECAT_ENTITLEMENT    = must match the dashboard identifier EXACTLY. A mismatch
#                               is silent: every event is classified other_entitlement.
# The dashboard's transfer behaviour must be "Transfer to new App User ID", otherwise a
# purchase made before sign-in never reaches the account.
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_ENTITLEMENT=plus

# ── AI Chapters (paid feature promised by the store listing) ─────────
# QUEST_CHAPTERS_ENABLED defaults to FALSE in config/services.php: without it every
# quest:generate-*-chapters command returns early and the store listing's "Chapitres IA
# récurrents" is sold but not delivered. Needs the scheduler (schedule:run every
# minute) AND a queue worker to produce anything.
ANTHROPIC_API_KEY=
QUEST_CHAPTERS_ENABLED=false
QUEST_CHAT_ENABLED=false
